{
  "name": "easii-md-preview",
  "publisher": "RodrigoAlexisPeralta",
  "displayName": "Easii Markdown Preview",
  "version": "1.0.0",
  "description": "GitHub-like Markdown preview with Shiki highlighting and secure HTML/PDF export for VS Code and Cursor.",
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigoperaltadev/easii-md-preview.git"
  },
  "homepage": "https://github.com/rodrigoperaltadev/easii-md-preview#readme",
  "bugs": {
    "url": "https://github.com/rodrigoperaltadev/easii-md-preview/issues"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:easiiMdPreview.openPreview",
    "onCommand:easiiMdPreview.exportHtml",
    "onCommand:easiiMdPreview.exportPdf"
  ],
  "contributes": {
    "commands": [
      {
        "command": "easiiMdPreview.openPreview",
        "title": "Easii Markdown Preview: Open Preview",
        "category": "Easii Markdown Preview"
      },
      {
        "command": "easiiMdPreview.exportHtml",
        "title": "Easii Markdown Preview: Export to HTML",
        "category": "Easii Markdown Preview"
      },
      {
        "command": "easiiMdPreview.exportPdf",
        "title": "Easii Markdown Preview: Export to PDF",
        "category": "Easii Markdown Preview"
      }
    ],
    "configuration": {
      "title": "Easii Markdown Preview",
      "properties": {
        "easiiMdPreview.pdf.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to Chrome, Edge, or Chromium for PDF export. Leave empty to auto-detect a local browser."
        }
      }
    }
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "bundle:production": "node esbuild.mjs --production",
    "compile": "npm run bundle",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run bundle:production",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "markdown",
    "preview",
    "github",
    "pdf",
    "export",
    "shiki",
    "syntax highlighting",
    "cursor",
    "vscode"
  ],
  "author": {
    "name": "Rodrigo Peralta",
    "email": "rodrigoperalta.dev@gmail.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "puppeteer-core": "^24.36.1",
    "shiki": "^3.4.2",
    "sanitize-html": "^2.17.4"
  }
}
